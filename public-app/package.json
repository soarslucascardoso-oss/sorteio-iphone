{
  "name": "sorteio-publico",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Site público + API de inscrições do sorteio (hospedado)",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "migrate": "node server/migrate.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "pg": "^8.23.1"
  }
}
